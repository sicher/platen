#!/usr/bin/env bash
# Regenerate the README gallery from PDFs rendered by platen itself: the
# showcase (src/showcase.zig -> examples/showcase.pdf) and a sample invoice
# (examples/benchmark_invoice.pdf). Both PDFs are committed and linked from
# the README; docs/images/*.png are their pages. Needs poppler's pdftoppm.
set -euo pipefail
cd "$(dirname "$0")/.."

command -v pdftoppm >/dev/null || { echo "pdftoppm (poppler) not found" >&2; exit 1; }

mkdir -p docs/images
zig build showcase
zig build bench-invoice -- --count=1 --output=examples/benchmark_invoice.pdf >/dev/null 2>&1

# 900 px wide: sharp on HiDPI when the README shows them at ~300 px
names=(typography graphics color)
for page in 1 2 3; do
    pdftoppm -png -f "$page" -l "$page" -singlefile -scale-to-x 900 -scale-to-y -1 \
        examples/showcase.pdf "docs/images/${names[page - 1]}"
done
pdftoppm -png -singlefile -scale-to-x 900 -scale-to-y -1 examples/benchmark_invoice.pdf docs/images/invoice

ls -l docs/images
