#!/usr/bin/env bash
# Regenerate the README gallery from PDFs rendered by platen itself: the
# showcase pages (src/showcase.zig -> examples/showcase_<name>.pdf) and a
# sample invoice (examples/benchmark_invoice.pdf). The PDFs are committed
# and each gallery image links to its PDF; docs/images/*.png are the
# rasterized pages. Needs poppler's pdftoppm.
set -euo pipefail
cd "$(dirname "$0")/.."

command -v pdftoppm >/dev/null || { echo "pdftoppm (poppler) not found" >&2; exit 1; }

mkdir -p docs/images
zig build showcase
zig build bench-invoice -- --count=1 --output=examples/benchmark_invoice.pdf >/dev/null 2>&1

# 900 px wide: sharp on HiDPI when the README shows them at ~300 px
for name in typography graphics color scripts; do
    pdftoppm -png -singlefile -scale-to-x 900 -scale-to-y -1 \
        "examples/showcase_$name.pdf" "docs/images/$name"
done
pdftoppm -png -singlefile -scale-to-x 900 -scale-to-y -1 examples/benchmark_invoice.pdf docs/images/invoice

ls -l docs/images
