#!/usr/bin/env bash
# Clone (and build) the local dev tools this project expects. .tools/ is
# gitignored -- each tool lives in its own repo, so a fresh clone starts
# without them.
#
#   devkit   release mechanism (devkit release / sync-dev / pin-deps / publish)
#   simgrep  code-duplication search
#   zigmap   codemap generator
#
# The body of this script is IDENTICAL in every urverk repo and only the
# two lists below differ. Keep it that way: a convention is one script
# with a per-repo list, not seven scripts that resemble each other.
#
# .tools/, never tools/. In quote, tools/ holds tracked project scripts
# (svg2tvg, sign_untrusted, ...), so a clone landing there is a collision
# that would surface exactly once, confusingly.
set -euo pipefail
cd "$(dirname "$0")/.."

HOST=https://git.urverk.org/urverk
DIR=.tools

CLONE="devkit simgrep zigmap"
BUILD="simgrep zigmap"

setup() { # name
  local name="$1" dir="$DIR/$1"
  # rev-parse, not [ -d "$dir/.git" ]: a submodule or a worktree has a
  # .git FILE, and the directory test sends those down the clone path
  # only to fail on a directory that is already there (platen, 07-26).
  if git -C "$dir" rev-parse --git-dir >/dev/null 2>&1; then
    echo "== $name: updating"
    git -C "$dir" pull --ff-only --quiet
  elif [ -e "$dir" ]; then
    echo "== $name: $dir exists but is not a checkout -- leaving it alone" >&2
  else
    echo "== $name: cloning"
    git clone --quiet "$HOST/$name" "$dir"
  fi
}

mkdir -p "$DIR"
for t in $CLONE; do setup "$t"; done

# The Zig ones are built on first setup; devkit runs from its checkout.
for t in $BUILD; do
  if [ -d "$DIR/$t" ] && [ ! -x "$DIR/$t/zig-out/bin/$t" ]; then
    echo "== $t: building"
    ( cd "$DIR/$t" && zig build -Doptimize=ReleaseFast )
  fi
done

if [ -n "$BUILD" ]; then
  echo "done -- clones in $DIR/, binaries under $DIR/*/zig-out/bin"
else
  echo "done -- clones in $DIR/"
fi
